local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")

local function esp()
	for _, desc in pairs(game:GetDescendants()) do
		if desc:IsA("Model") then
			print(desc.Name)

			local headbox = Instance.new("BoxHandleAdornment")
			headbox.Name = "HeadBox"
			headbox.Adornee = char.Head
			headbox.Size = Vector3.new(1.5, 1.5, 1.5)
			headbox.Color3 = Color3.new(1, 0, 0)
			headbox.Transparency = 0.9
			headbox.ZIndex = 10
			headbox.AlwaysOnTop = true
			headbox.Parent = desc

			local torsobox = Instance.new("BoxHandleAdornment")
			torsobox.Name = "TorsoBox"
			torsobox.Adornee = char.Torso
			torsobox.Size = Vector3.new(2, 2, 1)
			torsobox.Color3 = Color3.new(1, 0, 0)
			torsobox.Transparency = 0.9
			torsobox.ZIndex = 10
			torsobox.AlwaysOnTop = true
			torsobox.Parent = desc

			local rlbox = Instance.new("BoxHandleAdornment")
			rlbox.Name = "RLBox"
			rlbox.Adornee = char["Right Leg"]
			rlbox.Size = Vector3.new(1, 2, 1)
			rlbox.Color3 = Color3.new(1, 0, 0)
			rlbox.Transparency = 0.9
			rlbox.ZIndex = 10
			rlbox.AlwaysOnTop = true
			rlbox.Parent = desc

			local llbox = Instance.new("BoxHandleAdornment")
			llbox.Name = "LLBox"
			llbox.Adornee = char["Left Leg"]
			llbox.Size = Vector3.new(1, 2, 1)
			llbox.Color3 = Color3.new(1, 0, 0)
			llbox.Transparency = 0.9
			llbox.ZIndex = 10
			llbox.AlwaysOnTop = true
			llbox.Parent = desc

			local labox = Instance.new("BoxHandleAdornment")
			labox.Name = "LABox"
			labox.Adornee = char["Left Arm"]
			labox.Size = Vector3.new(1, 2, 1)
			labox.Color3 = Color3.new(1, 0, 0)
			labox.Transparency = 0.9
			labox.ZIndex = 10
			labox.AlwaysOnTop = true
			labox.Parent = desc

			local rabox = Instance.new("BoxHandleAdornment")
			rabox.Name = "RABox"
			rabox.Adornee = char["Right Arm"]
			rabox.Size = Vector3.new(1, 2, 1)
			rabox.Color3 = Color3.new(1, 0, 0)
			rabox.Transparency = 0.9
			rabox.ZIndex = 10
			rabox.AlwaysOnTop = true
			rabox.Parent = desc

			local mainbox = Instance.new("BoxHandleAdornment")
			mainbox.Name = "EspBox"
			mainbox.Adornee = char.HumanoidRootPart
			mainbox.Size = Vector3.new(4, 6, 2)
			mainbox.Color3 = Color3.new(0, 1, 1)
			mainbox.Transparency = 0.99
			mainbox.ZIndex = 8
			mainbox.AlwaysOnTop = true
			mainbox.Parent = desc
		end
	end

	game:GetService("Players").PlayerRemoving:Connect(function(leavingPlayer)
		print(player.Name .. " has lost esp box")
		if char then
			for _, espdestroy2 in pairs(game:GetDescendants()) do
				if espdestroy2:IsA("BoxHandleAdornment") then
					espdestroy2:Destroy()
					task.wait(1)
					esp()
				end
			end
		end
	end)
end

hum.Died:Connect(function()
	for _, espdestroyer in pairs(char:GetDescendants()) do
		if espdestroyer:IsA("BoxHandleAdornment") then
			espdestroyer:Destroy()
			task.wait(1)
			esp()
		end
	end
end)

for _, player in pairs(game.Players:GetPlayers()) do
	if player ~= game.Players.LocalPlayer then
		local character = player.Character or player.CharacterAdded:Wait()
		if character and character:FindFirstChild("Humanoid") then
			char = character
			esp()
			print(player.Name)
		end
	end
end

game.Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		char = character
		char:WaitForChild("Humanoid")
		esp()
		print(player.Name)
	end)
end)
